{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "types": [],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
